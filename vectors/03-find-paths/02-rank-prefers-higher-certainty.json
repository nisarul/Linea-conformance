      "paths": [
        { "from": "A", "to": "C", "length": 2, "certainty": "Certain",  "totalGap": 0, "gapEdges": 0, "classification": "lineage" },
        { "from": "A", "to": "C", "length": 2, "certainty": "Probable", "totalGap": 0, "gapEdges": 0, "classification": "lineage" }
      ]
    }
  }
