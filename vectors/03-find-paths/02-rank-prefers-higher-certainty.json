      { "id": "r3", "type": "ParentChild", "from": "A", "to": "Y", "certainty": "Certain",  "continuity": { "state": "Continuous" } },
      { "id": "r4", "type": "ParentChild", "from": "Y", "to": "C", "certainty": "Certain",  "continuity": { "state": "Continuous" } }
    ]
  },
  "operation": {
    "kind": "FindPaths",
    "from": "A",
    "to": "C"
